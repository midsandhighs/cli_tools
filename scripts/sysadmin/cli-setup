#!/bin/sh

# set -ex

# Script for doing some preliminary setup for customizing a terminal environment.
#
# NOTE: must be run from scripts/sysadmin/ — the config paths below are relative.
#
# usage message for script if no opts ($0) passed
me=$(basename "$0")
usage () {
    echo "$0 [-t] triage [-c] cli [-h] home"
    echo "[----$me----]"
    echo " triage: installs shells + tmux"
    echo " cli:    installs shells, tmux, vim (+ Vundle), and git config"
    echo " home:   not fully implemented yet (currently installs shells only)"
    exit 1
}
if [ $# -eq 0 ]; then
    usage
fi
# # # # # # #
# Helpers
# # # # # # #
#
# Copy SRC to DEST, backing up an existing DEST first so we never silently
# clobber a config the user already has.
install_file () {
    src=$1
    dest=$2
    if [ -e "$dest" ] || [ -L "$dest" ]; then
        backup="$dest.bak.$(date +%Y%m%d%H%M%S)"
        echo "Backing up existing $dest -> $backup"
        cp -R "$dest" "$backup"
    fi
    cp -Rv "$src" "$dest"
}
# # # # # # #
# Functions for setup steps
# # # # # # #
#
# shells function
shells () {
    echo 'Moving shell configurations'
    install_file ../../configs/shells/bashprofile "$HOME/.bash_profile"
    install_file ../../configs/shells/bashrc "$HOME/.bashrc"
    install_file ../../configs/shells/zshrc "$HOME/.zshrc"
}
# tmux function (named *_setup so it does not shadow the tmux binary)
tmux_setup () {
    echo 'Moving tmux configurations'
    install_file ../../configs/tools/tmux "$HOME/.tmux.conf"
}
# hammerspoon function
hammerspoon () {
    echo 'Moving hammerspoon configurations'
    mkdir -p "$HOME/.hammerspoon"
    install_file ../../configs/tools/hammerspoon "$HOME/.hammerspoon/init.lua"
}
# # vim install function
vim_setup () {
    echo 'Setting up vim'
    install_file ../../configs/tools/vimrc "$HOME/.vimrc"
    #  Verify Vundle exists, install if necessary, and install Vundles from .vimrc
    if [ -d "$HOME/.vim/bundle" ]; then
        echo 'Vundle folder exists!'
        vim +PluginInstall +qall
        echo 'Vundles updated.'
    else
        echo 'Vundle is not installed!'
        echo 'Cloning Vundle.vim'
        git clone https://github.com/gmarik/Vundle.vim.git "$HOME/.vim/bundle/Vundle.vim"
        echo 'Vundle Installed!'
        vim +PluginInstall +qall
        echo 'Vundles updated.'
    fi
}
git_config_setup () {
    echo 'Configuring git'
    echo 'Copying top-level config'
    install_file ../../configs/versioncontrol/gitconfig "$HOME/.gitconfig"
    if [ -d "$HOME/src/thd/" ]; then
        echo '/src/thd/ exists! This machine has THD repos'
        echo 'copying employer git configuration'
        install_file ../../configs/versioncontrol/gitconfig-thd "$HOME/.gitconfig-thd"
        echo 'copying personal git configuration'
        install_file ../../configs/versioncontrol/gitconfig-mids "$HOME/.gitconfig-mids"
    else
        echo 'copying personal git configuration'
        install_file ../../configs/versioncontrol/gitconfig-mids "$HOME/.gitconfig-mids"
    fi
}
# # # # # # #
# cli arguments
# # # # # # #
while getopts "tch" arg; do
    case "${arg}" in
        t ) # run triage setup
            echo "Setting up triage cli - shells & tmux"
            shells
            tmux_setup
            ;;
        c ) # run cli setup
            echo "Setting up shells, tmux, vim, and git"
            shells
            tmux_setup
            vim_setup
            git_config_setup
            ;;
        h ) # run home setup
            echo "Setting up home - shells only (not fully implemented)"
            shells
            ;;
        \? ) usage;;
    esac
done
